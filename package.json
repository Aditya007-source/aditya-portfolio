{
  "name": "signal-play-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run build && vite preview --configLoader native --host 127.0.0.1",
    "build": "tsc --noEmit && vite build --configLoader native && vite build --configLoader native --ssr src/entry-server.tsx --outDir .cache/ssr && node scripts/prerender.mjs",
    "preview": "vite preview --configLoader native --host 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "node scripts/verify.mjs",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "framer-motion": "13.1.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@babel/plugin-transform-react-jsx": "^7.27.0",
    "@babel/plugin-transform-typescript": "^7.28.0",
    "@playwright/test": "1.62.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.19.1",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "4.7.0",
    "autoprefixer": "10.4.21",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.5",
    "jsdom": "^30.1.1",
    "postcss": "8.5.6",
    "tailwindcss": "3.4.19",
    "terser": "^5.43.0",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.0",
    "vite": "6.4.3"
  }
}
